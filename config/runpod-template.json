{
  "name": "ACDEV WAN 2.2 I2V 14B ComfyUI Video",
  "imageName": "ghcr.io/acdevmedia/wan-comfyui:v0.1.0-rc.4",
  "containerDiskInGb": 200,
  "volumeInGb": 0,
  "volumeMountPath": "/workspace",
  "isPublic": false,
  "isServerless": false,
  "ports": [
    "8188/http",
    "3923/http"
  ],
  "env": {
    "VIDEO_VERSION": "2.2",
    "MODEL_MODE": "all",
    "COMFYUI_ATTENTION": "pytorch",
    "HF_HOME": "/workspace/.cache/huggingface",
    "COPYPARTY_USERNAME": "{{ RUNPOD_SECRET_COPYPARTY_USERNAME }}",
    "COPYPARTY_PASSWORD": "{{ RUNPOD_SECRET_COPYPARTY_SECRET }}",
    "HF_TOKEN": "{{ RUNPOD_SECRET_HUGGINGFACE_TOKEN }}"
  },
  "category": "NVIDIA"
}
