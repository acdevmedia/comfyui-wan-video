{
  "title": "ACDEV WAN 2.2 I2V 14B ComfyUI Video",
  "description": "WAN 2.2 14B image-to-video with standard, four-step LightX2V and experimental Remix v3 workflows.",
  "type": "serverless",
  "category": "video",
  "config": {
    "runsOn": "GPU",
    "endpointType": "LB",
    "containerDiskInGb": 200,
    "gpuCount": 1,
    "gpuIds": "AMPERE_80",
    "allowedCudaVersions": [
      "13.0"
    ],
    "env": [
      {
        "key": "VIDEO_VERSION",
        "value": "2.2"
      },
      {
        "key": "MODEL_MODE",
        "value": "turbo"
      },
      {
        "key": "COMFYUI_ATTENTION",
        "value": "pytorch"
      },
      {
        "key": "HF_HOME",
        "value": "/workspace/.cache/huggingface"
      },
      {
        "key": "COPYPARTY_USERNAME",
        "value": "{{ RUNPOD_SECRET_COPYPARTY_USERNAME }}"
      },
      {
        "key": "COPYPARTY_PASSWORD",
        "value": "{{ RUNPOD_SECRET_COPYPARTY_SECRET }}"
      },
      {
        "key": "HF_TOKEN",
        "value": "{{ RUNPOD_SECRET_HUGGINGFACE_TOKEN }}"
      },
      {
        "key": "PORT",
        "value": "8000"
      },
      {
        "key": "PORT_HEALTH",
        "value": "8001"
      }
    ]
  }
}
